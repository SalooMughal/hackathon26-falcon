# -----------------------
# Database Application Environment
# Options: development, production, staging
# -----------------------
NODE_ENV="development"

# -----------------------
# Security Keys
# -----------------------
AUTH_SECRET_KEY="your-auth-secret-key-here"
AUTH_REFRESH_SECRET_KEY="your-auth-refresh-secret-key-here"
CLIENT_SIDE_SECRET_KEY= # Secret key for encrypting/decrypting data between client and server (must match client-side encryption key)

# -----------------------
# Database Configuration
# -----------------------
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# -----------------------
# Google OAuth Configuration
# -----------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -----------------------
# OpenAI API Configuration
# Used for embeddings (always) and chat when ai.active_provider=openai
# -----------------------
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# -----------------------
# Pinecone Vector Database
# -----------------------
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="falconai-kb"
# Index dimension must match ai.embedding_dimensions (default 512 for text-embedding-3-small Matryoshka)

# -----------------------
# Swagger Documentation Authentication
# -----------------------
SWAGGER_USERNAME="admin"
SWAGGER_PASSWORD="your-swagger-password"
