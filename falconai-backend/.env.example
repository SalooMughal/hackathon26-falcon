# -----------------------
# Database Application Environment
# Options: development, production, staging
# -----------------------
NODE_ENV="development"

# -----------------------
# Security Keys
# -----------------------
AUTH_SECRET_KEY="your-auth-secret-key-here"
AUTH_REFRESH_SECRET_KEY="your-auth-refresh-secret-key-here"
CLIENT_SIDE_SECRET_KEY= # Secret key for encrypting/decrypting data between client and server (must match client-side encryption key)

# -----------------------
# Database Configuration
# -----------------------
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# -----------------------
# Google OAuth Configuration
# -----------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -----------------------
# OpenAI API Configuration
# -----------------------
OPENAI_API_KEY="your-openai-api-key"

# -----------------------
# Swagger Documentation Authentication
# -----------------------
SWAGGER_USERNAME="admin"
SWAGGER_PASSWORD="your-swagger-password"