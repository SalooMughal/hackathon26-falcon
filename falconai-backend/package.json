{
  "name": "falconai-backend",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "start": "pnpm db:migration:apply && ts-node src/index.ts",
    "build": "tsc",
    "serve": "pnpm db:migration:apply && node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "prebuild": "ts-node src/scripts/prebuild.ts",
    "postbuild": "ts-node src/scripts/postbuild.ts",
    "switchAlias": "ts-node src/scripts/switchPathAlias.ts",
    "db:seed": "ts-node -r module-alias/register src/scripts/initializeDatabase.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migration:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "db:migration:apply": "drizzle-kit migrate --config=./drizzle.config.ts",
    "commitlint": "commitlint",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "keywords": [],
  "author": "Muhammad Mamoor Ali",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "^3.1027.0",
    "@elastic/elasticsearch": "^9.3.4",
    "@google/generative-ai": "^0.24.1",
    "@pinecone-database/pinecone": "^8.0.0",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "nodemon": "^3.1.14",
    "openai": "^6.34.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-elasticsearch": "^0.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@dotenvar/cli": "^1.0.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/module-alias": "^2.0.4",
    "@types/multer": "^2.0.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "cpx": "^1.5.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3"
  },
  "_moduleAliases": {
    "@app": "./src"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --check"
    ]
  }
}
